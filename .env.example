# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_saas?schema=public"

# ============================================
# JWT AUTHENTICATION (CRITICAL - REQUIRED)
# ============================================
# IMPORTANT: Generate a secure secret with: openssl rand -base64 64
# Minimum length: 32 characters (64+ recommended for production)
# The server will NOT start without a properly configured JWT_SECRET
JWT_SECRET="CHANGE_ME_OR_SERVER_WILL_NOT_START_generate_with_openssl_rand_-base64_64"

# ============================================
# PAYMENT GATEWAY CONFIGURATIONS
# ============================================
# Paystack (Nigeria, Ghana, South Africa)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Paystack Webhook Secret - Get from Dashboard > Settings > Webhooks
# Used for webhook signature verification (CRITICAL for security)
PAYSTACK_SECRET_KEY=""

# Flutterwave
# Flutterwave Secret Hash - Get from Dashboard > Settings > Webhooks
# Used for webhook signature verification (CRITICAL for security)
FLUTTERWAVE_SECRET_HASH=""

# Stripe
STRIPE_SECRET_KEY=""
# Stripe Webhook Secret - Get from Dashboard > Developers > Webhooks
# Format: whsec_xxxxxxxxxxxxx (used for webhook signature verification)
STRIPE_WEBHOOK_SECRET=""

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Your production domain (required for CSRF/origin validation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="smsapp.com"

# Environment (affects error verbosity and security features)
# Set to "production" in live environments
NODE_ENV="development"
