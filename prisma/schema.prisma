datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  BURSAR
  TEACHER
  VIEWER
  PARENT
}

enum SubscriptionPlan {
  DEMO
  COPPER
  SILVER
  DIAMOND
  GOLD
  ENTERPRISE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  CANCELLED
}

model Tenant {
  id                String            @id @default(cuid())
  name              String
  alias             String            @default("SMS")
  subdomain         String            @unique
  customDomain      String?           @unique
  logoUrl           String?
  address           String?
  email             String?
  phone             String?
  currency          String            @default("GHS")
  
  plan              SubscriptionPlan  @default(DEMO)
  studentLimit      Int               @default(15)
  status            AccountStatus     @default(ACTIVE)
  
  users             User[]
  students          Student[]
  subjects          Subject[]
  classes           Class[]
  academicYears     AcademicYear[]
  billingCategories BillingCategory[]
  invoices          Invoice[]
  payments          Payment[]
  attendanceRecords Attendance[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  enrollments       Enrollment[]
  teachers          Teacher[]
  performances      Performance[]
  parents           Parent[]
  settings          Setting[]
  permissions       Permission[]
  billings          Billing[]

  // Operations department
  assets            Asset[]
  requisitions      Requisition[]
  workOrders        WorkOrder[]
  transportRoutes   TransportRoute[]
  vendors           Vendor[]

  // Marketing department
  campaigns         Campaign[]
  leads             Lead[]
  announcements     Announcement[]
  marketingEvents   MarketingEvent[]
  referrals         Referral[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Subscription {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan
  studentLimit       Int
  amount             Decimal          @db.Decimal(10, 2)
  currency           String           @default("GHS")
  billingCycle       String           @default("monthly")
  status             String           @default("active")
  paymentGateway     String           @default("paystack")
  gatewayReference   String?
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId])
}

model User {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  email            String
  username         String?
  passwordHash     String
  fullName         String
  role             Role          @default(TEACHER)
  status           AccountStatus @default(ACTIVE)
  phone            String?
  
  taughtClasses    Class[]       @relation("ClassTeacher")
  taughtSubjects   Subject[]     @relation("SubjectInstructor")
  recordedPayments Payment[]     @relation("PaymentRecorder")
  auditLogs        AuditLog[]
  parentProfiles   Parent[]      @relation("ParentUser")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model AcademicYear {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  year        String
  status      String       @default("Active")
  currentTerm String       @default("Term 1")

  classes     Class[]
  invoices    Invoice[]
  attendance  Attendance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, year])
  @@index([tenantId])
}

model Class {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name           String
  classTeacherId String?
  classTeacher   User?         @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  students       Student[]
  attendance     Attendance[]
  teachers       Teacher[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Subject {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  code         String?
  name         String
  instructorId String?
  instructor   User?         @relation("SubjectInstructor", fields: [instructorId], references: [id])
  instructorName String?
  credits      Int           @default(1)
  semester     String?
  status       AccountStatus @default(ACTIVE)
  enrollments  Enrollment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Student {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  studentId     String
  firstName     String
  lastName      String
  gender        String?
  dateOfBirth   DateTime?
  classId       String?
  class         Class?        @relation(fields: [classId], references: [id])
  
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  address       String?
  photoUrl      String?
  status        AccountStatus @default(ACTIVE)

  invoices       Invoice[]
  attendance     Attendance[]
  enrollments    Enrollment[]
  performances   Performance[]
  parentMappings Parent[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@index([tenantId, classId])
}

model Attendance {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  
  term           String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  notes          String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, studentId, date])
  @@index([tenantId, classId, date])
  @@index([tenantId, academicYearId, term])
}

model Billing {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  billingId   String
  item        String
  amount      Decimal  @default(0.00) @db.Decimal(10, 2)
  status      String   @default("Active")
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, billingId])
  @@index([tenantId])
}

model BillingCategory {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  categoryId    String?
  name          String
  academicYear  String?
  term          String?
  items         String?
  totalAmount   Decimal  @default(0.00) @db.Decimal(10, 2)
  defaultAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  description   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  invoiceNumber  String
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  term           String
  
  itemsJson      Json?
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  balance        Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime?

  payments       Payment[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, academicYearId, term])
}

model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  amount         Decimal  @db.Decimal(10, 2)
  paymentMethod  String
  transactionRef String?
  receiptNumber  String
  notes          String?
  
  recordedById   String?
  recordedBy     User?    @relation("PaymentRecorder", fields: [recordedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, invoiceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  
  createdAt DateTime @default(now())

  @@index([tenantId, entity])
  @@index([tenantId, createdAt])
}

model Enrollment {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  enrollmentId   String
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  courseCode     String?
  courseName     String?
  
  enrollmentDate DateTime?     @default(now())
  grade          String?
  status         String        @default("Active")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, enrollmentId])
  @@index([tenantId, studentId])
  @@index([tenantId, subjectId])
}

model Teacher {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  teacherId      String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  className      String?
  academicYear   String?
  status         AccountStatus @default(ACTIVE)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, teacherId])
  @@index([tenantId])
}

model Performance {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  performanceId  String?
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName    String?
  studentClass   String?
  term           String
  academicYear   String
  course         String
  
  classScore     Decimal       @default(0.00) @db.Decimal(5, 2)
  examScore100   Decimal       @default(0.00) @db.Decimal(5, 2)
  examScore60    Decimal       @default(0.00) @db.Decimal(5, 2)
  total          Decimal       @default(0.00) @db.Decimal(5, 2)
  grade          String?
  rank           String?
  remarks        String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, academicYear, term])
  @@index([tenantId, studentClass])
}

model Parent {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  mappingId      String
  parentUserId   String?
  parentUser     User?         @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: SetNull)
  parentName     String
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship   String?
  isPrimary      Boolean       @default(false)
  billing        String?
  phone          String?
  email          String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, mappingId])
  @@index([tenantId, studentId])
  @@index([tenantId, parentUserId])
}

model Setting {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  param          String
  value          String        @db.Text
  category       String?       @default("General")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, param])
  @@index([tenantId])
}

model Permission {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  role           String
  accessLevel    String
  actions        String

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, role])
  @@index([tenantId])
}

// ============================================================================
// OPERATIONS DEPARTMENT
// Every model is tenant-scoped exactly like the academic & finance models:
// `tenantId` + cascade delete + a `[tenantId, <code>]` uniqueness guarantee so
// human-readable codes (AST-1001, WO-1001 ...) never collide across schools.
// ============================================================================

model Asset {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetTag     String
  name         String
  category     String    @default("Other")
  quantity     Int       @default(1)
  unitCost     Decimal   @default(0.00) @db.Decimal(12, 2)
  location     String?
  condition    String    @default("Good")
  assignedTo   String?
  purchaseDate DateTime?
  status       String    @default("In Service")
  notes        String?   @db.Text

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Requisition {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requisitionNumber String
  title             String
  department        String    @default("Administration")
  requestedBy       String?
  itemsSummary      String?   @db.Text
  estimatedCost     Decimal   @default(0.00) @db.Decimal(12, 2)
  priority          String    @default("Medium")
  status            String    @default("Pending")
  neededBy          DateTime?
  supplier          String?
  notes             String?   @db.Text

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, requisitionNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model WorkOrder {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderNumber String
  title       String
  category    String    @default("Other")
  location    String?
  priority    String    @default("Medium")
  status      String    @default("Open")
  reportedBy  String?
  assignedTo  String?
  reportedOn  DateTime?
  dueDate     DateTime?
  cost        Decimal   @default(0.00) @db.Decimal(12, 2)
  notes       String?   @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model TransportRoute {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  routeCode        String
  routeName        String
  vehicleNumber    String?
  vehicleType      String   @default("Bus")
  driverName       String?
  driverPhone      String?
  capacity         Int      @default(0)
  studentsAssigned Int      @default(0)
  pickupPoints     String?  @db.Text
  fare             Decimal  @default(0.00) @db.Decimal(12, 2)
  status           String   @default("Active")
  notes            String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, routeCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vendorCode    String
  name          String
  category      String   @default("Other")
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String   @default("Cash on Delivery")
  status        String   @default("Active")
  notes         String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, vendorCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

// ============================================================================
// MARKETING DEPARTMENT
// ============================================================================

model Campaign {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  campaignCode    String
  name            String
  channel         String    @default("SMS")
  objective       String    @default("Admissions Drive")
  audience        String?
  budget          Decimal   @default(0.00) @db.Decimal(12, 2)
  spend           Decimal   @default(0.00) @db.Decimal(12, 2)
  startDate       DateTime?
  endDate         DateTime?
  status          String    @default("Draft")
  leadsGenerated  Int       @default(0)
  notes           String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, campaignCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Lead {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leadCode        String
  parentName      String
  phone           String?
  email           String?
  studentName     String?
  interestedClass String?
  source          String    @default("Walk-in")
  stage           String    @default("New")
  assignedTo      String?
  nextFollowUp    DateTime?
  notes           String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, leadCode])
  @@index([tenantId])
  @@index([tenantId, stage])
}

model Announcement {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  announcementCode String
  title            String
  audience         String    @default("All Parents")
  channel          String    @default("SMS")
  body             String    @db.Text
  publishAt        DateTime?
  status           String    @default("Draft")
  publishedBy      String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, announcementCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model MarketingEvent {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eventCode          String
  name               String
  type               String    @default("Open Day")
  venue              String?
  startDate          DateTime?
  endDate            DateTime?
  owner              String?
  expectedAttendees  Int       @default(0)
  actualAttendees    Int       @default(0)
  budget             Decimal   @default(0.00) @db.Decimal(12, 2)
  status             String    @default("Planned")
  notes              String?   @db.Text

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, eventCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Referral {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  referralCode  String
  referrerName  String
  referrerType  String   @default("Parent")
  referrerPhone String?
  prospectName  String
  prospectClass String?
  status        String   @default("Pending")
  rewardType    String   @default("None")
  rewardAmount  Decimal  @default(0.00) @db.Decimal(12, 2)
  rewardStatus  String   @default("Not Due")
  notes         String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, referralCode])
  @@index([tenantId])
  @@index([tenantId, status])
}
